<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_library_book_tree" model="ir.ui.view">
        <field name="name">library.book.list</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <list string="Books" decoration-success="state=='available'" decoration-muted="state=='borrowed'">
                <field name="name"/>
                <field name="author"/>
                <field name="isbn"/>
                <field name="publication_date"/>
                <field name="state" widget="badge" decoration-success="state=='available'" decoration-info="state=='borrowed'"/>
                <field name="borrowing_count"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_library_book_form" model="ir.ui.view">
        <field name="name">library.book.form</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form string="Book">
                <header>
                    <button name="action_set_available" string="Mark Available" type="object"
                            invisible="state == 'available'" class="oe_highlight"/>
                    <button name="action_view_borrowings" string="View Borrowing History" type="object"
                            invisible="borrowing_count == 0" class="oe_highlight"/>
                    <field name="state" widget="statusbar" statusbar_visible="available,borrowed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_borrowings" type="object" class="oe_stat_button" icon="fa-history">
                            <field name="borrowing_count" widget="statinfo" string="Borrowings"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name" placeholder="e.g., The Great Gatsby"/>
                            <field name="author" placeholder="e.g., F. Scott Fitzgerald"/>
                            <field name="isbn" placeholder="e.g., 978-0-7432-7356-5"/>
                        </group>
                        <group>
                            <field name="publication_date"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="current_borrowing_id" invisible="state != 'borrowed'" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes" placeholder="Additional information about this book..."/>
                        </page>
                    </notebook>
                </sheet>
                <Chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_library_book_search" model="ir.ui.view">
        <field name="name">library.book.search</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <search string="Books">
                <field name="name" string="Title/Author/ISBN"
                       filter_domain="['|', '|', ('name', 'ilike', self), ('author', 'ilike', self), ('isbn', 'ilike', self)]"/>
                <field name="author"/>
                <field name="isbn"/>
                <separator/>
                <filter string="Available" name="available" domain="[('state', '=', 'available')]"/>
                <filter string="Borrowed" name="borrowed" domain="[('state', '=', 'borrowed')]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Author" name="group_author" context="{'group_by': 'author'}"/>
                    <filter string="Publication Date" name="group_publication_date" context="{'group_by': 'publication_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_library_book_kanban" model="ir.ui.view">
        <field name="name">library.book.kanban</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column">
                <field name="id"/>
                <field name="name"/>
                <field name="author"/>
                <field name="state"/>
                <field name="borrowing_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    <div class="o_kanban_record_subtitle">
                                        <field name="author"/>
                                    </div>
                                </div>
                                <div>
                                    <field name="state" widget="label_selection"
                                           options="{'classes': {'available': 'success', 'borrowed': 'info'}}"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span><i class="fa fa-history"/> <field name="borrowing_count"/> borrowings</span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action -->
    <record id="action_library_book" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">library.book</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_available': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first book!
            </p>
            <p>
                Add books to your library inventory to start tracking borrowings.
            </p>
        </field>
    </record>
</odoo>
