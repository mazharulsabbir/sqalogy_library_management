<?xml version="1.0" encoding="utf-8"?>
<!-- WEEK 11: backend approval of book requests made on the website -->
<odoo>
    <record id="seq_library_book_request" model="ir.sequence">
        <field name="name">Library Book Request Sequence</field>
        <field name="code">library.book.request</field>
        <field name="prefix">REQ</field>
        <field name="padding">5</field>
    </record>

    <record id="view_library_book_request_list" model="ir.ui.view">
        <field name="name">library.book.request.list</field>
        <field name="model">library.book.request</field>
        <field name="arch" type="xml">
            <list string="Book Requests"
                  decoration-info="state == 'requested'"
                  decoration-muted="state in ('rejected', 'cancelled')">
                <field name="name"/>
                <field name="request_date"/>
                <field name="book_id"/>
                <field name="partner_id"/>
                <field name="member_id" optional="hide"/>
                <field name="book_state" widget="badge" optional="show"
                       decoration-success="book_state == 'available'"
                       decoration-warning="book_state == 'borrowed'"/>
                <field name="expected_return_date" optional="show"/>
                <field name="borrowing_id" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'requested'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"/>
                <button name="action_approve" type="object" string="Approve" icon="fa-check"
                        class="btn-link text-success" invisible="state != 'requested'"
                        groups="library_management.group_library_librarian"/>
            </list>
        </field>
    </record>

    <record id="view_library_book_request_form" model="ir.ui.view">
        <field name="name">library.book.request.form</field>
        <field name="model">library.book.request</field>
        <field name="arch" type="xml">
            <form string="Book Request">
                <header>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight"
                            invisible="state != 'requested'"
                            groups="library_management.group_library_librarian"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state != 'requested'"
                            groups="library_management.group_library_librarian"/>
                    <button name="action_reset_to_requested" string="Reset to Requested" type="object"
                            invisible="state not in ('rejected', 'cancelled')"
                            groups="library_management.group_library_librarian"/>
                    <field name="state" widget="statusbar" statusbar_visible="requested,approved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_borrowing" type="object" class="oe_stat_button"
                                icon="fa-book" invisible="not borrowing_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Borrowing</span>
                                <span class="o_stat_value"><field name="borrowing_id" readonly="1"/></span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="state != 'requested' or book_state != 'borrowed'">
                        This book is currently borrowed. It can be approved once it is returned.
                    </div>
                    <group>
                        <group>
                            <field name="book_id" readonly="state != 'requested'"/>
                            <field name="book_state" widget="badge"/>
                            <field name="partner_id" readonly="state != 'requested'"/>
                            <field name="member_id"/>
                        </group>
                        <group>
                            <field name="request_date"/>
                            <field name="expected_return_date" readonly="state != 'requested'"/>
                            <field name="reject_reason" invisible="state not in ('requested', 'rejected')"
                                   readonly="state != 'requested'"/>
                        </group>
                    </group>
                    <field name="message" placeholder="Message from the requester..." readonly="state != 'requested'"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_library_book_request_search" model="ir.ui.view">
        <field name="name">library.book.request.search</field>
        <field name="model">library.book.request</field>
        <field name="arch" type="xml">
            <search string="Book Requests">
                <field name="name"/>
                <field name="book_id"/>
                <field name="partner_id"/>
                <filter name="to_approve" string="To Approve" domain="[('state', '=', 'requested')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter name="book_available" string="Book Available" domain="[('book_state', '=', 'available')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_book" string="Book" context="{'group_by': 'book_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_library_book_request" model="ir.actions.act_window">
        <field name="name">Book Requests</field>
        <field name="res_model">library.book.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_to_approve': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No book requests yet</p>
            <p>Requests sent from the website book pages appear here for approval.</p>
        </field>
    </record>

    <menuitem id="menu_library_book_request"
              name="Book Requests"
              parent="menu_library_operations"
              action="action_library_book_request"
              sequence="25"
              groups="library_management.group_library_librarian"/>

    <!-- Smart button on the book form -->
    <record id="view_library_book_form_requests" model="ir.ui.view">
        <field name="name">library.book.form.requests</field>
        <field name="model">library.book</field>
        <field name="inherit_id" ref="library_management.view_library_book_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_requests" type="object" class="oe_stat_button" icon="fa-inbox">
                    <field name="pending_request_count" widget="statinfo" string="Requests"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
